root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,css}]
indent_style = space
indent_size = 4

[*.{json,yml,html,md}]
indent_style = space
indent_size = 2

[site/**]
indent_size = 2

[docs/chrome-web-store/source/**]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
