{
  "manifest_version": 3,
  "name": "YouTube Player for Twitch",
  "version": "1.4.0",
  "minimum_chrome_version": "102",
  "description": "Watch YouTube livestreams inside Twitch with stream discovery, live sync, and optional floating chat.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://kick.com/*",
    "https://www.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://api.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "https://7tv.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "twitch-playback.js",
        "twitch-directory.js",
        "twitch-emotes.js",
        "twitch-chat.js",
        "kick-support.js",
        "twitch-content.js"
      ],
      "css": [
        "twitch-styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
